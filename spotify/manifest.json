{
  "author": "Alex",
  "id": "com.alex.spotify",
  "name": "XE Player for Spotify",
  "description": "Unofficial Spotify player and queue for Xeneon Edge displays",
  "version": "1.0.0",
  "preview_icon": "resources/icon.svg",
  "min_app_version": "5.47",
  "min_framework_version": "1.4.0",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "interactive": true,
  "permissions": [
    { "type": "url", "domain": "api.spotify.com" },
    { "type": "url", "domain": "accounts.spotify.com" },
    { "type": "url", "domain": "scdn.co" }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd",
      "supportedSizes": ["small", "medium"]
    }
  ]
}
